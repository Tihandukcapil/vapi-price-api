# Copy to .env and adjust. Never commit a real .env with secrets.
# This project needs NO private key or secret at all — only public addresses/URLs.

# Payout wallet: USDC on Base goes here. Default is the user's app wallet.
PAY_TO=0xd7d8299ea24a1ff9225ee04587dbc42506a302b6

# x402 facilitator that verifies + settles payments on Base mainnet (eip155:8453).
# Default: PayAI public facilitator (verified live 2026-11-08: v2 exact on eip155:8453).
# Alternatives (no account needed): https://facilitator.xpay.sh, https://facilitator.0xarchive.io
# Production-grade alternative (needs a Coinbase Developer Platform account + API keys):
#   https://api.cdp.coinbase.com/platform/v2/x402
# NOTE: https://x402.org/facilitator is TESTNET ONLY (no eip155:8453) — do not use it here.
FACILITATOR_URL=https://facilitator.payai.network

# Facilitator call timeout in ms (the @x402 library default is 90000).
# A slow/unreachable facilitator fails the request with 402 instead of hanging it.
FACILITATOR_TIMEOUT_MS=15000

# Listen port
PORT=4021

# CoinGecko free public API (no key). Override only if you run a proxy.
COINGECKO_URL=https://api.coingecko.com/api/v3

# Price cache TTL in milliseconds (avoids hammering CoinGecko)
PRICE_CACHE_TTL_MS=30000
